VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Audio library base (no trailing slash)
# Local Vite / npm run preview with files in ./audio :
#   VITE_AUDIO_BASE_URL=/audio/recitations
# Production (GitHub Pages / custom domain):
#   VITE_AUDIO_BASE_URL=https://audio.alquranqiratacademy.com/recitations
#
# If unset: DEV defaults to /audio/recitations, production build defaults to remote URL.
VITE_AUDIO_BASE_URL=/audio/recitations
