# =============================================================================
# AQQA Learn — environment files
# =============================================================================
#
# Vite loads by mode:
#   npm run dev      → .env + .env.local + .env.development (+ *.local)
#   npm run build    → .env + .env.local + .env.production (+ *.local)
#
# Priority (highest wins): shell/CI env → .env.[mode].local → .env.local
#                          → .env.[mode] → .env
#
# Committed (safe public settings):
#   .env.development   local audio path, etc.
#   .env.production    live audio URL, etc.
#   .env.example       this file
#
# Gitignored (secrets / machine-specific):
#   .env.local         Supabase keys for ALL modes on your machine
#   .env               optional personal overrides
#
# Live deploy: GitHub Actions repo Variables override / supply:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_AUDIO_BASE_URL (optional; .env.production already sets remote audio)
# =============================================================================

# --- Required in .env.local (local) or GitHub Variables (live) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# --- Usually set by mode files; override here only if needed ---
# Local:   VITE_AUDIO_BASE_URL=/audio/recitations
# Live:    VITE_AUDIO_BASE_URL=https://audio.alquranqiratacademy.com/recitations
# VITE_AUDIO_BASE_URL=
